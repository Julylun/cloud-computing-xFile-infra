# ==============================================================================
# xFile Production Environment Configuration
# Copy this file to .env on the production VPS: cp .env.example .env
# ==============================================================================

# ── Cloud Database (External PostgreSQL / Neon) ──────────────────────────────
# Neon PostgreSQL connection string with SSL required
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/xfile_db?sslmode=require"

# ── Authentication & Security ────────────────────────────────────────────────
# High-entropy random secret key for JWT signing (e.g., openssl rand -hex 32)
JWT_SECRET=super_secret_production_jwt_signing_key_change_me_immediately

# ── Domain Configuration & URLs ──────────────────────────────────────────────
DOMAIN_FRONTEND=xFile.julylun.io.vn
DOMAIN_BACKEND=api-xFile.julylun.io.vn
DOMAIN_STATUS=status-xFile.julylun.io.vn

# Frontend public API target (used by browser)
NEXT_PUBLIC_API_URL=https://api-xfile.julylun.io.vn

# ── GHCR Container Images & Tags ─────────────────────────────────────────────
BACKEND_IMAGE=ghcr.io/julylun/cloud-computing-xfile-backend
BACKEND_TAG=latest

FRONTEND_IMAGE=ghcr.io/julylun/cloud-computing-xfile-frontend
FRONTEND_TAG=latest

# ── SMTP Mailer (Email OTP Verification) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM="xFile <no-reply@julylun.io.vn>"

# ── Observability & Monitoring ───────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_to_a_secure_password_in_production
